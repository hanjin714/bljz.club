---
const skillRepoUrl = "https://github.com/hanjin714/paradox-growth-advisor-skill";
---

<section id="hero" class="relative h-[285vh] overflow-clip bg-[var(--color-bg)]">
  <div class="sticky top-0 h-[100svh] min-h-[720px] overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-55">
      <img
        src="/assets/orbital-knowledge-atlas.png"
        alt=""
        class="h-full w-full object-cover object-center opacity-70"
        loading="eager"
      />
    </div>

    <div class="absolute inset-0 z-[1] bg-[radial-gradient(circle_at_64%_42%,rgba(66,211,146,0.16),transparent_31rem),linear-gradient(90deg,rgba(5,6,6,0.95),rgba(5,6,6,0.62)_48%,rgba(5,6,6,0.88))]"></div>

    <div class="absolute inset-0 z-[2]" id="atlas-3d-stage">
      <canvas id="atlas-3d-canvas" class="h-full w-full"></canvas>
    </div>

    <div class="pointer-events-none absolute left-5 right-5 top-24 z-10 mx-auto max-w-[1240px] md:left-10 md:right-10">
      <div class="flex items-center justify-between text-[10px] uppercase tracking-[0.22em] text-[var(--color-text-muted)]">
        <span>BLJZ.club / Public System</span>
        <span class="hidden md:inline">Scroll-driven atlas</span>
      </div>
    </div>

    <div class="hero-grid relative z-10 mx-auto grid h-full max-w-[1240px] grid-cols-1 items-center gap-9 px-5 pt-24 md:grid-cols-[0.92fr_1.08fr] md:px-10">
      <div class="hero-copy max-w-[610px]">
        <p class="hero-eyebrow">
          Now Available · Public Skill
        </p>
        <h1 class="hero-title mt-6 font-display font-black text-[var(--color-text)]">
          <span>现已推出：</span>
          悖论AI增长谋士 Skills
        </h1>
        <p class="hero-subtitle mt-6 max-w-[560px] text-base leading-7 text-[var(--color-text-secondary)] md:mt-7 md:text-xl md:leading-8">
          一套面向小团队、实体生意和新媒体转化的 AI O2O 增长方法论。先看业务循环，再找漏点，最后把内容、线索、判断和工具动作沉淀成可复用的 Skill。
        </p>

        <div class="launch-shelf mt-8 md:mt-10">
          <div class="app-icon" aria-hidden="true">
            <img src="/assets/paradox-growth-advisor-skill-hero.png" alt="" loading="eager" />
          </div>
          <div class="launch-meta">
            <strong>Paradox Growth Advisor</strong>
            <span>Public Skill · GitHub</span>
          </div>
          <a class="hero-action primary" href={skillRepoUrl} target="_blank" rel="noreferrer">
            查看仓库
          </a>
        </div>

        <div class="mt-4 flex flex-wrap gap-3">
          <a class="hero-action ghost" href="#course">进入 7 天公开课</a>
          <a class="hero-action ghost" href="#articles">阅读公开文章</a>
        </div>
      </div>

      <div class="hero-showcase w-full justify-self-end">
        <a class="skill-product" href={skillRepoUrl} target="_blank" rel="noreferrer" aria-label="打开悖论AI增长谋士 Skills GitHub 仓库">
          <div class="product-art">
            <img
              src="/assets/paradox-growth-advisor-skill-hero.png"
              alt="悖论AI增长谋士 Skills 产品视觉"
              loading="eager"
            />
          </div>
          <div class="product-copy">
            <div class="product-badges">
              <span>v1.0</span>
              <span>Public Release</span>
            </div>
            <h2>小团队 AI O2O 增长转化系统方法论</h2>
            <p>把 7 天公开课、个人表达风格、AI 产品经理思维和业务诊断动作，整理成一个可以被调用、确认、执行、再迭代的 Skill。</p>
            <div class="product-stats" aria-label="Skill 内容摘要">
              <span><strong>7</strong>Day</span>
              <span><strong>12</strong>Modules</span>
              <span><strong>O2O</strong>Growth</span>
            </div>
          </div>
        </a>

        <div class="hero-panel">
          <div class="hero-panel-head">
            <div>
              <p>Current Module</p>
              <span>Skill execution loop</span>
            </div>
            <strong id="hero-phase-counter">01 / 04</strong>
          </div>
          <div class="phase-stack" id="hero-phases">
            <div class="phase is-active" data-phase="0">
              <span>01</span>
              <strong>业务诊断</strong>
              <p>先用一句话讲清业务循环，再找最大漏点。</p>
            </div>
            <div class="phase" data-phase="1">
              <span>02</span>
              <strong>内容与线索</strong>
              <p>让内容不只负责播放量，也负责开口和记录。</p>
            </div>
            <div class="phase" data-phase="2">
              <span>03</span>
              <strong>工具边界</strong>
              <p>Agent 处理变化，workflow 处理重复，Codex 处理长期工具化。</p>
            </div>
            <div class="phase" data-phase="3">
              <span>04</span>
              <strong>执行迭代</strong>
              <p>用户确认后定制产出，再把结果回到下一轮优化。</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-scroll absolute bottom-8 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-3 text-[10px] uppercase tracking-[0.28em] text-[var(--color-text-muted)]">
      <span>Scroll to unfold</span>
      <div class="h-10 w-px overflow-hidden bg-white/10">
        <div id="scroll-thread" class="h-1/3 w-full bg-[var(--color-accent)]"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-eyebrow {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
  }

  .hero-title {
    max-width: 11ch;
    white-space: normal;
    font-size: clamp(3.25rem, 5.55vw, 5.85rem);
    line-height: 1.02;
    letter-spacing: 0;
    text-wrap: balance;
    text-shadow: 0 0 90px rgba(216, 150, 69, 0.2);
  }

  .hero-title span {
    display: block;
    margin-bottom: 0.28em;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 1vw, 0.96rem);
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .launch-shelf {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    max-width: 520px;
    padding: 0.68rem;
    border: 1px solid rgba(242, 232, 213, 0.11);
    border-radius: 22px;
    background: rgba(242, 232, 213, 0.055);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(18px);
  }

  .app-icon {
    height: 58px;
    width: 58px;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgba(242, 232, 213, 0.12);
    background: rgba(216, 150, 69, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 14px 34px rgba(0, 0, 0, 0.34);
  }

  .app-icon img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .launch-meta {
    min-width: 0;
  }

  .launch-meta strong {
    display: block;
    overflow: hidden;
    color: var(--color-text);
    font-size: 0.96rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .launch-meta span {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .hero-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border-radius: 999px;
    border: 1px solid rgba(216, 150, 69, 0.42);
    background: rgba(216, 150, 69, 0.12);
    color: var(--color-text);
    padding: 0 1.25rem;
    white-space: nowrap;
    font-size: 0.875rem;
    transition: transform 260ms ease, border-color 260ms ease, background 260ms ease;
  }

  .hero-action:hover {
    transform: translateY(-2px);
    border-color: rgba(216, 150, 69, 0.72);
    background: rgba(216, 150, 69, 0.18);
  }

  .hero-action.ghost {
    border-color: rgba(242, 232, 213, 0.16);
    background: rgba(242, 232, 213, 0.04);
    color: var(--color-text-secondary);
  }

  .hero-action.primary {
    border-color: rgba(66, 211, 146, 0.5);
    background: rgba(66, 211, 146, 0.16);
  }

  .hero-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.78fr);
    align-items: center;
    gap: 1.4rem;
  }

  .skill-product {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid rgba(242, 232, 213, 0.1);
    border-radius: 30px;
    background: linear-gradient(145deg, rgba(242, 232, 213, 0.1), rgba(5, 6, 6, 0.78));
    color: inherit;
    box-shadow: 0 48px 120px rgba(0, 0, 0, 0.42);
    transform: translateZ(0);
    transition: transform 320ms ease, border-color 320ms ease, box-shadow 320ms ease;
  }

  .skill-product:hover {
    transform: translateY(-4px);
    border-color: rgba(216, 150, 69, 0.28);
    box-shadow: 0 58px 140px rgba(0, 0, 0, 0.5);
  }

  .product-art {
    aspect-ratio: 1.18;
    overflow: hidden;
    border-bottom: 1px solid rgba(242, 232, 213, 0.08);
  }

  .product-art img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    transform: scale(1.02);
  }

  .product-copy {
    padding: 1.25rem;
  }

  .product-badges,
  .product-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }

  .product-badges span,
  .product-stats span {
    border: 1px solid rgba(242, 232, 213, 0.1);
    border-radius: 999px;
    background: rgba(242, 232, 213, 0.045);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .product-badges span {
    padding: 0.32rem 0.54rem;
  }

  .product-copy h2 {
    margin-top: 0.9rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.05vw, 2.2rem);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .product-copy p {
    margin-top: 0.8rem;
    color: var(--color-text-secondary);
    font-size: 0.86rem;
    line-height: 1.75;
  }

  .product-stats {
    margin-top: 1rem;
  }

  .product-stats span {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    min-height: 30px;
    padding: 0.26rem 0.58rem;
  }

  .product-stats strong {
    color: var(--color-accent);
    font-size: 0.72rem;
  }

  .hero-panel {
    position: relative;
    min-height: 360px;
    border-left: 1px solid rgba(242, 232, 213, 0.14);
    padding-left: 1.4rem;
    perspective: 1100px;
  }

  .hero-panel::after {
    content: "";
    position: absolute;
    left: -1px;
    top: 0;
    width: 1px;
    height: 28%;
    background: linear-gradient(180deg, transparent, var(--color-signal), transparent);
    box-shadow: 0 0 28px rgba(66, 211, 146, 0.48);
    transform-origin: top;
  }

  .hero-panel-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid rgba(242, 232, 213, 0.1);
  }

  .hero-panel-head p,
  .hero-panel-head strong,
  .hero-panel-head span {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .hero-panel-head p {
    color: var(--color-text-secondary);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
  }

  .hero-panel-head span {
    display: block;
    margin-top: 0.45rem;
    color: var(--color-text-muted);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
  }

  .hero-panel-head strong {
    color: var(--color-accent);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .phase-stack {
    position: relative;
    height: 276px;
    margin-top: 1.25rem;
    overflow: hidden;
    transform-style: preserve-3d;
  }

  .phase {
    position: absolute;
    inset: 0 0 auto;
    min-height: 138px;
    padding: 1.35rem 1.45rem;
    overflow: hidden;
    border: 1px solid rgba(242, 232, 213, 0.09);
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(242, 232, 213, 0.06), rgba(5, 6, 6, 0.78));
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.3);
    color: var(--color-text-muted);
    opacity: 0;
    transform-origin: 50% 20%;
    will-change: transform, opacity, filter;
  }

  .phase::before {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(90deg, var(--color-signal), rgba(216, 150, 69, 0.7), transparent 78%);
    opacity: 0;
    transform: scaleX(0.18);
    transform-origin: left;
    transition: opacity 460ms ease, transform 760ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .phase span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent);
  }

  .phase strong {
    display: block;
    margin-top: 0.45rem;
    color: inherit;
    font-family: var(--font-display);
    font-size: 1.18rem;
  }

  .phase p {
    max-width: 25rem;
    margin-top: 0.55rem;
    font-size: 0.84rem;
    line-height: 1.75;
  }

  .phase.is-active {
    color: var(--color-text);
    border-color: rgba(66, 211, 146, 0.34);
    background: linear-gradient(135deg, rgba(66, 211, 146, 0.12), rgba(216, 150, 69, 0.09), rgba(5, 6, 6, 0.88));
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.46), 0 0 68px rgba(66, 211, 146, 0.055);
  }

  .phase.is-active::before {
    opacity: 1;
    transform: scaleX(1);
  }

  @media (max-width: 767px) {
    #hero {
      height: 230vh;
    }

    #hero .sticky {
      min-height: 910px;
    }

    #atlas-3d-stage {
      opacity: 0.72;
      transform: translate(13%, 8%);
    }

    .hero-grid {
      align-content: start;
      align-items: start;
      gap: 1.2rem;
      padding-top: 8rem;
      padding-bottom: 4.5rem;
    }

    .hero-title {
      max-width: 9.8ch;
      font-size: clamp(2.55rem, 12vw, 3.55rem);
      line-height: 1.04;
    }

    .hero-subtitle {
      max-width: 21rem;
    }

    .launch-shelf {
      grid-template-columns: 48px minmax(0, 1fr);
      max-width: 100%;
      border-radius: 18px;
    }

    .app-icon {
      height: 48px;
      width: 48px;
      border-radius: 14px;
    }

    .launch-shelf .hero-action {
      grid-column: 1 / -1;
      width: 100%;
    }

    .hero-action {
      min-height: 40px;
      padding: 0 0.95rem;
      font-size: 0.78rem;
    }

    .hero-showcase {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-top: 0.4rem;
    }

    .skill-product {
      border-radius: 22px;
    }

    .product-art {
      aspect-ratio: 2.2;
    }

    .product-copy {
      padding: 1rem;
    }

    .product-copy h2 {
      font-size: 1.28rem;
    }

    .product-copy p,
    .product-stats {
      display: none;
    }

    .hero-panel {
      min-height: 170px;
      max-width: none;
      border-left: 0;
      border-top: 1px solid rgba(242, 232, 213, 0.12);
      padding-left: 0;
      padding-top: 1rem;
      margin-top: 1.25rem;
    }

    .hero-panel::after {
      top: -1px;
      left: 0;
      width: 34%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--color-signal), transparent);
    }

    .hero-panel-head {
      padding-bottom: 0.7rem;
    }

    .hero-panel-head span {
      display: none;
    }

    .phase-stack {
      height: 112px;
      margin-top: 0.8rem;
    }

    .phase {
      min-height: 112px;
      padding: 0.9rem 1rem;
    }

    .phase strong {
      font-size: 0.98rem;
    }

    .phase p {
      font-size: 0.8rem;
      line-height: 1.65;
    }

    .hero-scroll {
      bottom: 1.25rem;
      opacity: 0.65;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const phaseEls = Array.from(document.querySelectorAll<HTMLElement>(".phase"));
  const scrollThread = document.getElementById("scroll-thread");
  const phaseCounter = document.getElementById("hero-phase-counter");
  let currentPhase = -1;

  function renderPhases(activeIndex: number, immediate = false) {
    if (activeIndex === currentPhase && !immediate) return;
    currentPhase = activeIndex;
    const mobile = window.innerWidth < 768;

    phaseEls.forEach((el, index) => {
      const offset = index - activeIndex;
      const distance = Math.abs(offset);
      el.classList.toggle("is-active", offset === 0);
      gsap.to(el, {
        x: mobile ? distance * 5 : distance * 16,
        y: mobile ? offset * 24 : offset * 82,
        z: offset === 0 ? 34 : -distance * 48,
        scale: offset === 0 ? 1 : Math.max(mobile ? 0.93 : 0.84, 1 - distance * 0.075),
        opacity: offset === 0 ? 1 : Math.max(mobile ? 0 : 0.12, 0.5 - distance * 0.14),
        filter: `blur(${offset === 0 ? 0 : Math.min(5, distance * 1.4)}px)`,
        rotateX: mobile ? 0 : offset * -3,
        duration: immediate ? 0 : 0.72,
        ease: "expo.out",
        overwrite: true,
      });
    });

    if (phaseCounter) phaseCounter.textContent = `${String(activeIndex + 1).padStart(2, "0")} / 04`;
  }

  renderPhases(0, true);

  gsap.fromTo(
    ".hero-eyebrow, .hero-title, .hero-subtitle, .launch-shelf, .hero-action.ghost, .skill-product, .hero-panel",
    { y: 34, opacity: 0 },
    { y: 0, opacity: 1, duration: 1.1, stagger: 0.08, ease: "power3.out" }
  );

  ScrollTrigger.create({
    trigger: "#hero",
    start: "top top",
    end: "bottom bottom",
    scrub: true,
    onUpdate: (self) => {
      const phase = Math.min(3, Math.floor(self.progress * 4));
      renderPhases(phase);
      if (scrollThread) {
        scrollThread.style.transform = `translateY(${self.progress * 70}px)`;
      }
      window.dispatchEvent(new CustomEvent("atlas-progress", { detail: self.progress }));
    },
  });

  window.addEventListener("resize", () => renderPhases(currentPhase, true), { passive: true });

  async function initAtlas() {
    const THREE = await import("three");
    const canvas = document.getElementById("atlas-3d-canvas") as HTMLCanvasElement | null;
    const stage = document.getElementById("atlas-3d-stage");
    if (!canvas || !stage) return;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
    camera.position.set(0, 0.25, 7.2);

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, preserveDrawingBuffer: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, window.innerWidth < 768 ? 1.25 : 1.6));

    const group = new THREE.Group();
    group.position.x = 1.55;
    scene.add(group);

    const copper = new THREE.Color(0xd89645);
    const signal = new THREE.Color(0x42d392);
    const ivory = new THREE.Color(0xf2eadb);

    const ringMaterial = new THREE.MeshBasicMaterial({
      color: copper,
      transparent: true,
      opacity: 0.28,
    });
    const paleMaterial = new THREE.MeshBasicMaterial({
      color: ivory,
      transparent: true,
      opacity: 0.1,
    });
    const signalMaterial = new THREE.MeshBasicMaterial({
      color: signal,
      transparent: true,
      opacity: 0.88,
    });

    const rings: THREE.Mesh[] = [];
    [1.08, 1.62, 2.18, 2.72].forEach((radius, index) => {
      const ring = new THREE.Mesh(
        new THREE.TorusGeometry(radius, index === 0 ? 0.012 : 0.007, 24, 220),
        index === 2 ? paleMaterial.clone() : ringMaterial.clone()
      );
      ring.rotation.x = Math.PI * (0.38 + index * 0.045);
      ring.rotation.y = Math.PI * (0.12 - index * 0.07);
      ring.rotation.z = index * 0.36;
      ring.userData.baseRotation = ring.rotation.clone();
      rings.push(ring);
      group.add(ring);
    });

    const nodes: THREE.Mesh[] = [];
    const nodeGeo = new THREE.SphereGeometry(0.035, window.innerWidth < 768 ? 12 : 20, window.innerWidth < 768 ? 12 : 20);
    const nodeCount = window.innerWidth < 768 ? 14 : 34;
    for (let i = 0; i < nodeCount; i++) {
      const theta = i * 0.74;
      const radius = 1.08 + (i % 4) * 0.54;
      const node = new THREE.Mesh(nodeGeo, i % 5 === 0 ? signalMaterial.clone() : ringMaterial.clone());
      node.position.set(Math.cos(theta) * radius, Math.sin(theta) * radius * 0.36, Math.sin(theta * 0.7) * 0.58);
      node.userData.seed = theta;
      node.userData.radius = radius;
      nodes.push(node);
      group.add(node);
    }

    const curveMaterial = new THREE.LineBasicMaterial({
      color: 0xf2eadb,
      transparent: true,
      opacity: 0.09,
    });
    const lines: THREE.Line[] = [];
    for (let i = 0; i < nodes.length - 1; i += 2) {
      const geometry = new THREE.BufferGeometry().setFromPoints([nodes[i].position.clone(), nodes[i + 1].position.clone()]);
      const line = new THREE.Line(geometry, curveMaterial.clone());
      lines.push(line);
      group.add(line);
    }

    const core = new THREE.Mesh(
      new THREE.IcosahedronGeometry(0.34, 1),
      new THREE.MeshBasicMaterial({ color: 0xf0c27a, wireframe: true, transparent: true, opacity: 0.46 })
    );
    group.add(core);

    let targetProgress = 0;
    let progress = 0;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let stageIsVisible = true;
    let animationFrame = 0;
    window.addEventListener("atlas-progress", (event) => {
      targetProgress = (event as CustomEvent<number>).detail;
    });

    function resize() {
      const rect = stage.getBoundingClientRect();
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, rect.width < 768 ? 1 : 1.6));
      renderer.setSize(rect.width, rect.height);
      camera.aspect = rect.width / rect.height;
      camera.updateProjectionMatrix();
      group.position.x = rect.width < 768 ? 0.9 : 1.5;
      group.position.y = rect.width < 768 ? -0.18 : 0;
      group.scale.setScalar(rect.width < 768 ? 0.62 : 1.02);
      if (reduceMotion) renderer.render(scene, camera);
    }
    resize();
    window.addEventListener("resize", resize);

    function drawFrame() {
      progress += (targetProgress - progress) * 0.08;
      const t = performance.now() * 0.001;

      group.rotation.y = -0.5 + progress * 1.35 + Math.sin(t * 0.2) * 0.06;
      group.rotation.x = 0.04 + progress * 0.52;
      group.rotation.z = -progress * 0.24;
      group.position.z = Math.sin(progress * Math.PI) * 0.72;

      rings.forEach((ring, index) => {
        ring.rotation.z = ring.userData.baseRotation.z + t * (0.05 + index * 0.012) + progress * (index + 1) * 0.54;
        ring.scale.setScalar(1 + progress * (0.06 + index * 0.035));
        (ring.material as THREE.MeshBasicMaterial).opacity = 0.18 + Math.sin(progress * Math.PI) * 0.2;
      });

      nodes.forEach((node, index) => {
        const spread = 1 + progress * 0.58;
        const theta = node.userData.seed + progress * (1.2 + (index % 3) * 0.15);
        const radius = node.userData.radius * spread;
        node.position.x = Math.cos(theta) * radius;
        node.position.y = Math.sin(theta) * radius * (0.36 + progress * 0.18);
        node.position.z = Math.sin(theta * 0.7 + progress * 2.1) * (0.58 + progress * 0.8);
        node.scale.setScalar(1 + Math.sin(t * 2 + index) * 0.18 + progress * 0.45);
      });

      lines.forEach((line, index) => {
        const a = nodes[index * 2];
        const b = nodes[index * 2 + 1];
        if (!a || !b) return;
        const attr = line.geometry.getAttribute("position") as THREE.BufferAttribute;
        attr.setXYZ(0, a.position.x, a.position.y, a.position.z);
        attr.setXYZ(1, b.position.x, b.position.y, b.position.z);
        attr.needsUpdate = true;
        (line.material as THREE.LineBasicMaterial).opacity = 0.05 + progress * 0.16;
      });

      core.rotation.x += 0.003;
      core.rotation.y -= 0.004;
      core.scale.setScalar(1 + progress * 0.45);

      renderer.render(scene, camera);
    }

    function animate() {
      animationFrame = 0;
      if (!stageIsVisible || document.hidden || reduceMotion) return;
      drawFrame();
      animationFrame = requestAnimationFrame(animate);
    }

    function startAnimation() {
      if (reduceMotion) {
        drawFrame();
        return;
      }
      if (!animationFrame && stageIsVisible && !document.hidden) {
        animationFrame = requestAnimationFrame(animate);
      }
    }

    const stageObserver = new IntersectionObserver(([entry]) => {
      stageIsVisible = entry.isIntersecting;
      if (stageIsVisible) startAnimation();
    }, { rootMargin: "120px 0px" });
    stageObserver.observe(stage);

    document.addEventListener("visibilitychange", startAnimation);
    startAnimation();
  }

  initAtlas();
</script>
