---
import ContentLayout from "../layouts/ContentLayout.astro";
import KnowledgeArticle from "./KnowledgeArticle.astro";
import type { ArticleEntry } from "../lib/content";

const {
  article,
  canonicalPath = `/articles/${article.slug}`,
} = Astro.props as {
  article: ArticleEntry;
  canonicalPath?: string;
};
---

<ContentLayout
  title={article.title}
  eyebrow={`${article.series} / ${article.date}`}
  summary={article.excerpt}
  externalUrl={article.externalUrl}
  externalLabel={article.externalLabel}
  canonicalPath={canonicalPath}
  image={article.image}
>
  {article.image && (
    <figure class="article-media mt-14 overflow-hidden rounded-[8px] border border-[var(--color-border)] bg-black/30">
      <img
        src={article.image}
        alt={article.imageAlt ?? ""}
        width={article.imageWidth}
        height={article.imageHeight}
        class="h-auto max-h-[72vh] w-full object-contain"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  )}

  <section class="mt-14 overflow-hidden rounded-[8px] border border-[var(--color-border)] bg-[rgba(242,232,213,0.04)] p-6 backdrop-blur-md md:p-8">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.22em] text-[var(--color-accent)]">Thinking Route</p>
        <h2 class="mt-3 font-display text-2xl font-bold md:text-3xl">这篇文章的判断路径</h2>
      </div>
      <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-text-muted)]">Read left to right</span>
    </div>

    <div class="map-flow mt-8" aria-label="文章思维路径">
      {article.map.map((item, index) => (
        <div class="map-step">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{item}</strong>
        </div>
      ))}
    </div>
  </section>

  <KnowledgeArticle sections={article.sections} />

  {article.links && article.links.length > 0 && (
    <section class="mt-12 border-t border-[var(--color-border)] pt-8">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-text-muted)]">Project Links</p>
      <div class="mt-5 flex flex-wrap gap-3">
        {article.links.map((link) => (
          <a class="article-link" href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))}
      </div>
    </section>
  )}
</ContentLayout>

<style>
  .map-flow {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .map-step {
    position: relative;
    min-width: 0;
    border-top: 1px solid rgba(216, 150, 69, 0.42);
    padding-top: 1rem;
  }

  .map-step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: -1px;
    left: calc(100% + 0.35rem);
    width: 0.8rem;
    height: 1px;
    background: rgba(66, 211, 146, 0.5);
  }

  .map-step span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-accent);
  }

  .map-step strong {
    display: block;
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: 1.06rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .article-link {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(216, 150, 69, 0.34);
    border-radius: 999px;
    padding: 0 1.1rem;
    color: var(--color-text);
    background: rgba(216, 150, 69, 0.08);
    font-size: 0.82rem;
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
  }

  .article-link:hover {
    transform: translateY(-1px);
    border-color: rgba(216, 150, 69, 0.68);
    background: rgba(216, 150, 69, 0.14);
  }

  @media (max-width: 767px) {
    .map-flow {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .map-step {
      border-top: 0;
      border-left: 1px solid rgba(216, 150, 69, 0.38);
      padding: 0.2rem 0 1.4rem 1.2rem;
    }

    .map-step::before {
      content: "";
      position: absolute;
      left: -4px;
      top: 0.45rem;
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: var(--color-signal);
      box-shadow: 0 0 16px rgba(66, 211, 146, 0.45);
    }

    .map-step:not(:last-child)::after {
      display: none;
    }
  }
</style>
