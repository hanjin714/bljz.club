---
const { id, density = "medium" } = Astro.props as { id: string; density?: "low" | "medium" | "high" };
---

<div class="section-orbit pointer-events-none absolute inset-0 z-0 overflow-hidden" data-density={density}>
  <canvas id={`section-orbit-${id}`} class="absolute inset-0 h-full w-full opacity-70"></canvas>
</div>

<script>
  import * as THREE from "three";

  function initOneSectionOrbit(canvas: HTMLCanvasElement) {
    const host = canvas.parentElement;
    const section = canvas.closest("section") || canvas.closest("main");
    if (!host || !section) return;
    if (canvas.dataset.ready === "true") return;
    canvas.dataset.ready = "true";

    const orbitDensity = (host as HTMLElement).dataset.density || "medium";

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(48, 1, 0.1, 100);
    camera.position.z = 5.2;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, preserveDrawingBuffer: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const group = new THREE.Group();
    group.position.x = 1.65;
    scene.add(group);

    const copper = new THREE.MeshBasicMaterial({ color: 0xd89645, transparent: true, opacity: 0.22 });
    const green = new THREE.MeshBasicMaterial({ color: 0x42d392, transparent: true, opacity: 0.65 });
    const pale = new THREE.LineBasicMaterial({ color: 0xf2eadb, transparent: true, opacity: 0.08 });

    const ringCount = orbitDensity === "high" ? 5 : orbitDensity === "low" ? 2 : 3;
    const nodeCount = orbitDensity === "high" ? 34 : orbitDensity === "low" ? 14 : 24;
    const rings = [];
    const nodes = [];

    for (let i = 0; i < ringCount; i++) {
      const ring = new THREE.Mesh(
        new THREE.TorusGeometry(0.9 + i * 0.42, 0.005, 18, 160),
        copper.clone()
      );
      ring.rotation.x = Math.PI * (0.36 + i * 0.04);
      ring.rotation.y = Math.PI * (0.08 - i * 0.03);
      ring.rotation.z = i * 0.5;
      group.add(ring);
      rings.push(ring);
    }

    const nodeGeo = new THREE.SphereGeometry(0.024, 14, 14);
    for (let i = 0; i < nodeCount; i++) {
      const material = i % 6 === 0 ? green.clone() : copper.clone();
      const node = new THREE.Mesh(nodeGeo, material);
      const theta = i * 0.78;
      const radius = 0.92 + (i % ringCount) * 0.42;
      node.position.set(Math.cos(theta) * radius, Math.sin(theta) * radius * 0.42, Math.sin(theta * 0.6) * 0.48);
      node.userData.theta = theta;
      node.userData.radius = radius;
      group.add(node);
      nodes.push(node);
    }

    const lines = [];
    for (let i = 0; i < nodes.length - 1; i += 3) {
      const line = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([nodes[i].position.clone(), nodes[i + 1].position.clone()]),
        pale.clone()
      );
      group.add(line);
      lines.push({ line, a: nodes[i], b: nodes[i + 1] });
    }

    let target = 0;
    let progress = 0;

    function updateProgress() {
      const rect = section.getBoundingClientRect();
      const total = rect.height + window.innerHeight;
      target = Math.min(1, Math.max(0, (window.innerHeight - rect.top) / total));
    }

    function resize() {
      const rect = host.getBoundingClientRect();
      renderer.setSize(rect.width, rect.height);
      camera.aspect = rect.width / rect.height;
      camera.updateProjectionMatrix();
      group.position.x = rect.width < 768 ? 0.2 : 1.65;
      group.position.y = rect.width < 768 ? -0.15 : 0;
      group.scale.setScalar(rect.width < 768 ? 0.8 : 1.05);
      updateProgress();
    }

    resize();
    window.addEventListener("resize", resize);
    window.addEventListener("scroll", updateProgress, { passive: true });

    function animate() {
      requestAnimationFrame(animate);
      progress += (target - progress) * 0.075;
      const t = performance.now() * 0.001;
      group.rotation.y = -0.5 + progress * 1.4;
      group.rotation.x = 0.25 + Math.sin(t * 0.2) * 0.08;
      group.rotation.z = -0.08 + progress * 0.24;

      rings.forEach((ring, index) => {
        ring.rotation.z += 0.0015 + index * 0.0004;
        ring.scale.setScalar(1 + Math.sin(progress * Math.PI) * 0.08 + index * 0.018);
      });

      nodes.forEach((node, index) => {
        const theta = node.userData.theta + progress * (0.75 + index * 0.004);
        const radius = node.userData.radius * (1 + progress * 0.28);
        node.position.x = Math.cos(theta) * radius;
        node.position.y = Math.sin(theta) * radius * 0.42;
        node.position.z = Math.sin(theta * 0.6 + progress) * 0.6;
      });

      lines.forEach(({ line, a, b }) => {
        const attr = line.geometry.getAttribute("position");
        attr.setXYZ(0, a.position.x, a.position.y, a.position.z);
        attr.setXYZ(1, b.position.x, b.position.y, b.position.z);
        attr.needsUpdate = true;
      });

      renderer.render(scene, camera);
    }

    animate();
  }

  document.querySelectorAll<HTMLCanvasElement>(".section-orbit canvas").forEach(initOneSectionOrbit);
</script>
