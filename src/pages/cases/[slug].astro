---
import CasePage from "../../components/CasePage.astro";
import { publicCases } from "../../lib/content";

export function getStaticPaths() {
  return publicCases.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
---

<CasePage item={item} />
